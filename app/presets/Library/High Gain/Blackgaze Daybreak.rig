<headroom-tempo bpm="160.000"/>
<headroom-library version="1" id="hg-blackgaze-daybreak" category="High Gain" order="110" instrument="guitar" style="Blackgaze">
  <description>A blackgaze wall: a sustaining fuzz into a 120-watt lead channel at moderate gain, a 4x12, a soft analog-style echo and a huge modulated reverb. Tremolo-pick open chords and let them bloom into a bright, overwhelming haze; Freeze holds the wash under a riff.</description>
  <tags><tag>High Gain</tag><tag>Blackgaze</tag><tag>Post-Metal</tag><tag>Wall of Sound</tag><tag>Fuzz</tag><tag>Delay</tag><tag>Reverb</tag></tags>
  <sources>
    <source url="https://www.premierguitar.com/artists/deafheavens-kerry-mccoy-grasping-at-hooks" title="Premier Guitar: Deafheaven's Kerry McCoy"/>
    <source url="https://equipboard.com/albums/deafheaven-sunbather" title="Equipboard: Deafheaven, Sunbather"/>
    <source url="https://www.premierguitar.com/artists/alcests-neige-describes-a-place-where-blackness-and-beauty-meet" title="Premier Guitar: Alcest's Neige"/>
    <source url="https://www.guitarworld.com/features/wolves-in-the-throne-room-primordial-arcana" title="Guitar World: Wolves in the Throne Room, Primordial Arcana"/>
  </sources>
</headroom-library>
</headroom-preset>
