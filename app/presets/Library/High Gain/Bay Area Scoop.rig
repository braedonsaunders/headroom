    <source url="https://en.wikipedia.org/wiki/Mesa/Boogie_Mark_IIC%2B" title="Mesa/Boogie Mark IIC+ (Wikipedia)"/>
    <source url="https://blog.zzounds.com/2017/05/20/legends-tone-slayer/" title="zZounds: Legends of tone, Slayer"/>
    <source url="https://equipboard.com/albums/testament-the-new-order" title="Equipboard: Testament, The New Order"/>
  </sources>
</headroom-library>
