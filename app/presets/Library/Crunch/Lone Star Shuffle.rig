    <source url="https://en.wikipedia.org/wiki/Jimmie_Vaughan" title="Jimmie Vaughan (Wikipedia)"/>
    <source url="https://www.guitarworld.com/lessons/stevie-ray-vaughan-5-licks" title="Guitar World: Stevie Ray Vaughan virtually defined the art of the Texas shuffle"/>
  </sources>
</headroom-library>
