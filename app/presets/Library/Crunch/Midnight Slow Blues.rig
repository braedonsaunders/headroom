    <component-audio version="1">
      <parameters num-parameters="14">
        <parameter id="CASSt" value="0.5"/>
        <parameter id="volume" value="0.62"/>
        <parameter id="bright" value="1"/>
        <parameter id="treble" value="0.68"/>
        <parameter id="bass" value="0.42"/>
        <parameter id="reverb intensity" value="0.5"/>
        <parameter id="reverb on" value="0"/>
        <parameter id="reverb mode" value="0"/>
