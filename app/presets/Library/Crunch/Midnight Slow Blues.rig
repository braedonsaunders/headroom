  <connection-data><target controller-slot-id="2" component-id="15000" target-number="1" target-name="Tn" min-value="0.2" max-value="0.7" controller-name="Tone"/></connection-data>
  <connection-data><target controller-slot-id="3" component-id="172000" target-number="1" target-name="treble" min-value="0.3" max-value="0.8" controller-name="Treble"/></connection-data>
