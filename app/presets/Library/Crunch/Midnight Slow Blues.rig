</headroom-rig>
<headroom-library version="1" id="crunch-midnight-slow-blues" category="Crunch" order="40" instrument="guitar" style="Blues">
  <description>Warm, singing slow-blues lead: a low-drive green overdrive used as a boost into a small blackface combo at the edge, with a generous spring tank. Built for the neck pickup. Bends bloom and sustain; roll the guitar volume back and it cleans up for the verses.</description>
  <tags><tag>Crunch</tag><tag>Blues</tag><tag>Lead</tag><tag>Neck Pickup</tag><tag>Overdrive</tag><tag>Spring Reverb</tag></tags>
  <sources>
    <source url="https://www.guitarchalk.com/fender-65-deluxe-reverb-settings/" title="Guitar Chalk: Fender '65 Deluxe Reverb amp settings and tone tips"/>
    <source url="https://en.wikipedia.org/wiki/Fender_Deluxe" title="Fender Deluxe (Wikipedia)"/>
    <source url="https://www.premierguitar.com/gear/top-4-blues-rock-rig-rundowns" title="Premier Guitar: Top 4 blues-rock Rig Rundowns"/>
    <source url="https://en.wikipedia.org/wiki/Ibanez_Tube_Screamer" title="Ibanez Tube Screamer (Wikipedia)"/>
  </sources>
</headroom-library>
</headroom-preset>
