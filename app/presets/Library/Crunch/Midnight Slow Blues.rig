<?xml version="1.0" encoding="UTF-8"?>
<headroom-preset version="1">
<headroom-info><soundinfo><properties><name>Midnight Slow Blues</name><author>Headroom</author></properties></soundinfo></headroom-info>
<headroom-rig>
<metadata preset-name="Midnight Slow Blues" preset-author="Headroom" preset-comment="Warm, singing slow-blues lead: a low-drive green overdrive used as a boost into a small blackface combo at the edge, with a generous spring tank. Built for the neck pickup. Bends bloom and sustain; roll the guitar volume back and it cleans up for the verses." based-on="" based-on-path=""/>
