</headroom-rig>
<headroom-library version="1" id="crunch-windmill-stack" category="Crunch" order="130" instrument="guitar" style="Classic Rock">
  <description>A 100-watt Partridge-transformer head with channel one on full, bass right down and treble high, into its matching 4x12: loud, clear, punchy crunch with huge headroom, where every note in a big chord stays distinct. A clean boost adds push. Made for windmill power chords and trio rock; the guitar volume sets the dirt.</description>
  <tags><tag>Crunch</tag><tag>Classic Rock</tag><tag>Power Trio</tag><tag>Rhythm</tag><tag>Power Chords</tag><tag>Boost</tag></tags>
  <sources>
    <source url="https://www.thewho.net/whotabs/gear/guitar/cp103.html" title="thewho.net: Hiwatt CP103 and DR103W (Pete's typical settings 1969-73)"/>
    <source url="https://reverb.com/news/the-whos-live-at-leeds-a-primer-for-pete-townshends-tone" title="Reverb: The Who's Live at Leeds, a primer for Pete Townshend's tone"/>
    <source url="https://en.wikipedia.org/wiki/Hiwatt" title="Hiwatt (Wikipedia)"/>
  </sources>
</headroom-library>
</headroom-preset>
