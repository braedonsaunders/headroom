<headroom-preset version="1">
<headroom-info><soundinfo><properties><name>Windmill Stack</name><author>Headroom</author></properties></soundinfo></headroom-info>
<headroom-rig>
<metadata preset-name="Windmill Stack" preset-author="Headroom" preset-comment="A 100-watt Partridge-transformer head with channel one on full, bass right down and treble high, into its matching 4x12: loud, clear, punchy crunch with huge headroom, where every note in a big chord stays distinct. A clean boost adds push. Made for windmill power chords and trio rock; the guitar volume sets the dirt." based-on="" based-on-path=""/>
<rack>
