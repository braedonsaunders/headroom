    <source url="https://en.wikipedia.org/wiki/Marshall_Super_Lead" title="Marshall Super Lead (Wikipedia)"/>
    <source url="https://www.electrosmash.com/dallas-rangemaster" title="ElectroSmash: Dallas Rangemaster circuit analysis"/>
  </sources>
</headroom-library>
