<headroom-library version="1" id="numb-solo" category="Artist Tones" order="10" instrument="guitar" style="Classic Rock">
  <description>Singing, sustaining fuzz lead after the closing solo: a ram's-head-style fuzz into a moderately driven 100-watt British head and 4x12, a slow rotating speaker blended underneath, a long low-level echo and a big hall.</description>
  <tags><tag>Artist Tones</tag><tag>Classic Rock</tag><tag>Prog</tag><tag>Lead</tag><tag>Fuzz</tag><tag>Rotary</tag><tag>Delay</tag></tags>
  <inspired-by artist="David Gilmour (Pink Floyd)" song="Comfortably Numb" album="The Wall" part="Second (outro) solo" year="1979"/>
  <sources>
    <source url="https://www.guitarworld.com/features/the-secrets-behind-david-gilmours-tone-on-pink-floyds-comfortably-numb" title="Guitar World: the secrets behind David Gilmour's tone on Comfortably Numb"/>
    <source url="http://www.kitrae.net/music/Music_mp3_Comfortably_Numb_Sound.html" title="Kit Rae: Comfortably Numb solo gear and sound analysis"/>
    <source url="https://reverb.com/news/how-to-nail-gilmours-comfortably-numb-solo" title="Reverb: How to nail Gilmour's Comfortably Numb solo"/>
    <source url="https://en.wikipedia.org/wiki/Comfortably_Numb" title="Comfortably Numb (Wikipedia)"/>
  </sources>
</headroom-library>
