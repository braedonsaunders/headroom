<headroom-tempo bpm="126.000"/>
<headroom-library version="1" id="streets-intro" category="Artist Tones" order="30" instrument="guitar" style="Post-Punk / Arena Rock">
  <description>The chiming intro arpeggio: a short slap echo and a dotted-eighth delay in front of a class-A top-boost combo set just at breakup. Rig tempo is 126 BPM so the repeats lock to the part; mute-pick eighth notes and let the delay fill in the rest.</description>
  <tags><tag>Artist Tones</tag><tag>Rock</tag><tag>Post-Punk</tag><tag>Delay</tag><tag>Dotted Eighth</tag><tag>Chime</tag></tags>
  <inspired-by artist="The Edge (U2)" song="Where the Streets Have No Name" album="The Joshua Tree" part="Intro arpeggio" year="1987"/>
  <sources>
    <source url="https://www.guitarchalk.com/where-the-streets-have-no-name-amp-settings/" title="Guitar Chalk: Where the Streets Have No Name amp settings and gear"/>
    <source url="https://www.amnesta.net/edge_delay/" title="Tim Darling: A study of the Edge's guitar delay"/>
  </sources>
</headroom-library>
</headroom-preset>
