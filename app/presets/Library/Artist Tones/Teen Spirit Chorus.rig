<headroom-tempo bpm="117.000"/>
<headroom-library version="1" id="teen-spirit-chorus" category="Artist Tones" order="50" instrument="guitar" style="Grunge">
  <description>The loud chorus riff: a hard-clipping orange distortion pedal at full level into a clean, mid-heavy preamp and a 4x12, double-tracked wide. A bypassed chorus waits for the quiet verse and pre-chorus: switch it on and the distortion off.</description>
  <tags><tag>Artist Tones</tag><tag>Grunge</tag><tag>Alternative</tag><tag>Distortion</tag><tag>Rhythm</tag><tag>Chorus</tag></tags>
  <inspired-by artist="Kurt Cobain (Nirvana)" song="Smells Like Teen Spirit" album="Nevermind" part="Chorus power-chord riff" year="1991"/>
  <sources>
    <source url="https://www.guitarworld.com/features/the-secrets-behind-kurt-cobains-guitar-tone-on-nirvanas-smells-like-teen-spirit" title="Guitar World: Kurt Cobain's guitar tone on Smells Like Teen Spirit"/>
    <source url="https://www.groundguitar.com/tone-breakdown/kurt-cobain-nevermind-guitars-amps-effects/" title="Ground Guitar: Kurt Cobain's Nevermind gear"/>
    <source url="https://pedalplayers.com/kurt-cobains-pedals/" title="PedalPlayers: Kurt Cobain's pedals, the gear myth debunked"/>
  </sources>
</headroom-library>
</headroom-preset>
