<headroom-library version="1" id="pride-and-joy-rhythm" category="Artist Tones" order="20" instrument="guitar" style="Texas Blues">
  <description>Big, percussive Texas shuffle: loud, high-headroom blackface amps right at the edge, a barely-there overdrive push, then the studio Dimension chorus and room added at mixdown. Heavy strings and a hard right hand do the rest.</description>
  <tags><tag>Artist Tones</tag><tag>Blues</tag><tag>Texas Blues</tag><tag>Shuffle</tag><tag>Rhythm</tag><tag>Clean-ish</tag></tags>
  <inspired-by artist="Stevie Ray Vaughan" song="Pride and Joy" album="Texas Flood" part="Main shuffle rhythm" year="1983"/>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Texas_Flood" title="Texas Flood (Wikipedia)"/>
    <source url="https://blog.line6.com/2023/05/19/jas-obrecht-stevie-ray-vaughans-texas-flood-sessions/" title="Jas Obrecht: Stevie Ray Vaughan's Texas Flood sessions (Line 6 blog)"/>
    <source url="https://www.loudersound.com/features/stevie-ray-vaughan-the-making-of-texas-flood" title="Louder: Stevie Ray Vaughan, the making of Texas Flood"/>
    <source url="https://www.guitarworld.com/news/john-mayer-stevie-ray-vaughan-texas-flood-dumble-amp" title="Guitar World: John Mayer owns the Dumble SRV used on Texas Flood"/>
  </sources>
</headroom-library>
</headroom-preset>
