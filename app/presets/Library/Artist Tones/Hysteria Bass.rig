<headroom-tempo bpm="94.000"/>
<headroom-library version="1" id="hysteria-bass" category="Artist Tones" order="60" instrument="bass" style="Alternative Rock">
  <description>Driving fuzz bass for a busy sixteenth-note line: a clean tube bass amp keeps the low end solid while a parallel fuzz-into-cranked-amp lane adds the snarl on top. Blend the two with the Fuzz macro.</description>
  <tags><tag>Artist Tones</tag><tag>Bass</tag><tag>Alternative</tag><tag>Fuzz Bass</tag><tag>Parallel</tag><tag>Multi-amp</tag></tags>
  <inspired-by artist="Chris Wolstenholme (Muse)" song="Hysteria" album="Absolution" part="Main bass riff" year="2003"/>
  <sources>
    <source url="https://www.musewiki.org/Rich_Costey:_Recording_Muse's_Absolution_(200312_Sound_on_Sound_article)" title="Sound On Sound (Dec 2003): Rich Costey, recording Muse's Absolution (MuseWiki mirror)"/>
    <source url="https://en.wikipedia.org/wiki/Hysteria_(Muse_song)" title="Hysteria (Muse song), Wikipedia"/>
    <source url="https://musewiki.org/Hysteria_(song)" title="MuseWiki: Hysteria (song)"/>
    <source url="https://www.guitarworld.com/features/too-much-is-never-enough-muses-chris-wolstenholme-reinvents-art-rock-bass-for-the-21st-century" title="Guitar World: Muse's Chris Wolstenholme reinvents art-rock bass"/>
  </sources>
</headroom-library>
