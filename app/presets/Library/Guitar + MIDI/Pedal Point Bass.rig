<headroom-tempo bpm="110.000"/>
<headroom-library version="1" id="bl-pedal-point" category="Guitar + MIDI" order="60" instrument="guitar" style="Arpeggiated Bass">
  <description>Let a chord ring and an octave-down synth bass blooms under it: the root on every other step, the chord tones between, locked to the groove you were strumming. Strum again and the bass steps aside until the next ring.</description>
  <tags><tag>Bloom</tag><tag>Arpeggio</tag><tag>Crunch</tag><tag>Bass</tag><tag>Synth</tag><tag>Guitar + MIDI</tag><tag>Poly</tag></tags>
  <sources>
