<headroom-tempo bpm="112.000"/>
<headroom-library version="1" id="gm-tracked-octave-fuzz" category="Guitar + MIDI" order="80" instrument="guitar" style="Hybrid Psych Fuzz">
  <description>A saw synth plays an octave above whatever you play and is squashed, together with the guitar, through a germanium fuzz into a tweed 4x10. Like an octave fuzz, but the upper octave is tracked, so it holds on chords and never glitches. The fuzz turns the two into one ringing, raspy voice.</description>
  <tags><tag>Guitar + MIDI</tag><tag>Fused</tag><tag>Fuzz</tag><tag>Octave</tag><tag>Synth</tag><tag>Lead</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://paulreno.com/ehx-micro-synthesizer/" title="Paul Reno: history and versions of the EHX Micro Synthesizer"/>
    <source url="https://sfsonic.com/interviews/interview-adrian-belew-tony-levin-talk-beat-and-their-legacy-with-king-crimson/" title="SF Sonic: Adrian Belew &amp; Tony Levin on BEAT and King Crimson (the GR-300)"/>
  </sources>
</headroom-library>
</headroom-preset>
