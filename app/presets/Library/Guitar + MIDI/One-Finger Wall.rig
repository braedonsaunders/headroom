<headroom-tempo bpm="92.000"/>
<headroom-library version="1" id="gm-one-finger-wall" category="Guitar + MIDI" order="50" instrument="guitar" style="Hybrid Stoner Metal">
  <description>Every note on the low and middle strings becomes a square-wave power chord (root and fifth), pushed with the guitar into a cranked British 120-watt head. Synth and string distort together: a one-finger riff lands like a full stack playing fifths, a strum like a wall. Interval goes from octaves to sus4.</description>
  <tags><tag>Guitar + MIDI</tag><tag>Fused</tag><tag>High Gain</tag><tag>Harmony</tag><tag>Synth</tag><tag>Rhythm</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Testify_(Rage_Against_the_Machine_song)" title="Wikipedia: Testify (Whammy set to harmonize above the played note)"/>
    <source url="https://www.tdpri.com/threads/royal-blood-how-mike-kerr-gets-that-big-sound.803464/" title="TDPRI: how Mike Kerr gets that big sound (octave split into guitar and bass amps)"/>
  </sources>
</headroom-library>
</headroom-preset>
