<headroom-tempo bpm="84.000"/>
<headroom-library version="1" id="bl-freeze-choir" category="Guitar + MIDI" order="20" instrument="guitar" style="Freeze &amp; Solo">
  <description>Hold a chord and step on Engage: the chord freezes into a pedal-point arpeggio of choir and your own strings, and stays there while you solo over it. Bend a note and the whole arpeggio bends with you. Release Engage to let it go.</description>
  <tags><tag>Bloom</tag><tag>Arpeggio</tag><tag>Freeze</tag><tag>Crunch</tag><tag>Lead</tag><tag>Guitar + MIDI</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Arpeggiator" title="Wikipedia: Arpeggiator"/>
    <source url="https://www.ehx.com/products/freeze/" title="Electro-Harmonix: Freeze Sound Retainer"/>
    <source url="https://en.wikipedia.org/wiki/Roland_GR-300" title="Wikipedia: Roland GR-300"/>
  </sources>
</headroom-library>
</headroom-preset>
