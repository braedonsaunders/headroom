<headroom-tempo bpm="96.000"/>
<headroom-library version="1" id="gm-drawbar-grind" category="Guitar + MIDI" order="90" instrument="guitar" style="Hybrid Classic Rock">
  <description>Full drawbars follow your chords and are driven, with the guitar, through an overdrive into a cranked, jumpered tweed combo and a 2x12, then a photocell vibe. Organ and strings break up in the same 6V6s, so riffs come out as one growling, swirling organ-guitar. Organ sets how much drawbar hits the overdrive.</description>
  <tags><tag>Guitar + MIDI</tag><tag>Fused</tag><tag>Crunch</tag><tag>Organ</tag><tag>Vibe</tag><tag>Rhythm</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Roland_GR-300" title="Wikipedia: Roland GR-300 (guitar, synth, or a mix of the two)"/>
    <source url="https://sfsonic.com/interviews/interview-adrian-belew-tony-levin-talk-beat-and-their-legacy-with-king-crimson/" title="SF Sonic: Adrian Belew &amp; Tony Levin on BEAT and King Crimson (the GR-300)"/>
  </sources>
</headroom-library>
</headroom-preset>
