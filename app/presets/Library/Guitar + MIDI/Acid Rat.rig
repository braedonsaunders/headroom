<headroom-tempo bpm="124.000"/>
<headroom-library version="1" id="gm-acid-rat" category="Guitar + MIDI" order="40" instrument="guitar" style="Hybrid Acid Rock">
  <description>A squelching 303-style acid synth shadows every note and chord you play and is driven with the guitar into an op-amp filter distortion and a blackface combo. Its resonant filter opens on every pick and the pedal fuses the two into one spitting voice. Poly: lines and strums both play; bends stay in the guitar.</description>
  <tags><tag>Guitar + MIDI</tag><tag>Fused</tag><tag>Crunch</tag><tag>Acid</tag><tag>Synth</tag><tag>Lead</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://paulreno.com/ehx-micro-synthesizer/" title="Paul Reno: history and versions of the EHX Micro Synthesizer"/>
    <source url="https://catalinbread.com/blogs/catalinbread-cabinet/ehx-v1-micro-synthesizer" title="Catalinbread: the Electro-Harmonix V1 Micro Synthesizer"/>
    <source url="https://en.wikipedia.org/wiki/Roland_GR-300" title="Wikipedia: Roland GR-300 (guitar, synth, or a mix of the two)"/>
  </sources>
</headroom-library>
</headroom-preset>
