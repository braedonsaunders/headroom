<headroom-tempo bpm="120.000"/>
<headroom-library version="1" id="gm-synth-body" category="Guitar + MIDI" order="60" instrument="guitar" style="Hybrid Modern Metal">
  <description>A parallel split: the guitar lane runs the boost and the British master-volume head into a 4x12 and is then shelved hard below about 180 Hz, while a tracked sub synth supplies the whole low register. The amp gives the grind, the synth gives the body, and neither is a sound on its own. Body ↔ Grind balances them.</description>
  <tags><tag>Guitar + MIDI</tag><tag>Fused</tag><tag>High Gain</tag><tag>Sub</tag><tag>Split</tag><tag>Synth</tag><tag>Rhythm</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://www.musicradar.com/news/mike-kerr-talks-royal-bloods-meteoric-rise-his-elusive-bass-rig-and-how-did-we-get-so-dark" title="MusicRadar: Mike Kerr on Royal Blood's bass rig (POG and pitch pedals)"/>
    <source url="https://www.tdpri.com/threads/royal-blood-how-mike-kerr-gets-that-big-sound.803464/" title="TDPRI: how Mike Kerr gets that big sound (octave split into guitar and bass amps)"/>
  </sources>
</headroom-library>
</headroom-preset>
