<headroom-tempo bpm="96.000"/>
<headroom-library version="1" id="bl-garden" category="Guitar + MIDI" order="10" instrument="guitar" style="Ambient Arpeggio">
  <description>Strum a chord and let it ring: after half a second it blooms into a walking arpeggio of its own strings, re-plucked, with glass bells under them, in the key you are playing. Pick again and it gets out of the way. The same chord always blooms the same way; mute the strings to stop it.</description>
  <tags><tag>Bloom</tag><tag>Arpeggio</tag><tag>Clean</tag><tag>Ambient</tag><tag>Guitar + MIDI</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Arpeggiator" title="Wikipedia: Arpeggiator"/>
    <source url="https://www.ehx.com/products/freeze/" title="Electro-Harmonix: Freeze Sound Retainer"/>
    <source url="https://en.wikipedia.org/wiki/Roland_GR-300" title="Wikipedia: Roland GR-300"/>
  </sources>
</headroom-library>
