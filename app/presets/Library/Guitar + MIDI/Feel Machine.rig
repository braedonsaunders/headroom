<headroom-tempo bpm="100.000"/>
<headroom-library version="1" id="bl-feel-machine" category="Guitar + MIDI" order="30" instrument="guitar" style="Groove Arpeggio">
  <description>A glassy synth arpeggiates every chord you hold, locked to your own strumming: it learns your tempo, swing and accents as you play, no click needed. Each chord plays its own figure, the same every time; staccato when you palm-mute.</description>
  <tags><tag>Bloom</tag><tag>Arpeggio</tag><tag>Clean</tag><tag>Funk</tag><tag>Synth</tag><tag>Guitar + MIDI</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Arpeggiator" title="Wikipedia: Arpeggiator"/>
    <source url="https://www.ehx.com/products/freeze/" title="Electro-Harmonix: Freeze Sound Retainer"/>
    <source url="https://en.wikipedia.org/wiki/Roland_GR-300" title="Wikipedia: Roland GR-300"/>
  </sources>
</headroom-library>
</headroom-preset>
