<headroom-tempo bpm="110.000"/>
<headroom-library version="1" id="gm-chainsaw-choir" category="Guitar + MIDI" order="20" instrument="guitar" style="Hybrid Death Metal">
  <description>A breathy, resonant choir synth follows your chords and is fed, with the guitar, into a dimed Swedish chainsaw distortion and a small tweed combo. The choir's noise and filter get sawed up with the strings: a buzzing, haunted wall that is one thing, not two. Weld sets how much choir enters the pedal.</description>
  <tags><tag>Guitar + MIDI</tag><tag>Fused</tag><tag>High Gain</tag><tag>Chainsaw</tag><tag>Choir</tag><tag>Synth</tag><tag>Poly</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Roland_GR-300" title="Wikipedia: Roland GR-300 (guitar, synth, or a mix of the two)"/>
    <source url="https://guitarfxdepot.com/music/trent-reznor-on-recording-the-fragile/" title="Guitar World (2000, transcribed): Trent Reznor on recording The Fragile (guitars through the Mutator filters)"/>
  </sources>
</headroom-library>
</headroom-preset>
