<?xml version="1.0" encoding="UTF-8"?>
<headroom-preset version="1">
<headroom-info><soundinfo><properties><name>Highlife Bright</name><author>Headroom</author></properties></soundinfo></headroom-info>
<headroom-rig>
<metadata preset-name="Highlife Bright" preset-author="Headroom" preset-comment="Crisp, bright and sweet clean for interlocking highlife and soukous lines: light compression into a blackface combo with treble up and bass trimmed, driving four 10-inch speakers, in a small room. Play light, percussive two-finger patterns and short melodic ostinatos; every note rings clear." based-on="" based-on-path=""/>
<rack>
<non-fix-components>
  <component id="48000">
    <component-audio version="1">
      <parameters num-parameters="7">
        <parameter id="V" value="0.75"/>
        <parameter id="S" value="0.5"/>
        <parameter id="A" value="0.4"/>
        <parameter id="R" value="0.4"/>
        <parameter id="T" value="0.55"/>
        <parameter id="C" value="0"/>
        <parameter id="Pwr" value="1"/>
      </parameters>
    </component-audio>
  </component>
  <component id="172000">
    <component-audio version="1">
      <parameters num-parameters="14">
        <parameter id="CASSt" value="0.5"/>
        <parameter id="volume" value="0.4"/>
        <parameter id="bright" value="1"/>
        <parameter id="treble" value="0.68"/>
        <parameter id="bass" value="0.36"/>
        <parameter id="reverb intensity" value="0.5"/>
        <parameter id="reverb on" value="0"/>
        <parameter id="reverb mode" value="0"/>
        <parameter id="speed" value="0.5"/>
        <parameter id="intensity" value="0.5"/>
        <parameter id="tremolo on" value="0"/>
        <parameter id="tremolo sag" value="0.5"/>
        <parameter id="tempo sync" value="0"/>
        <parameter id="Pwr" value="1"/>
      </parameters>
    </component-audio>
  </component>
  <component id="156000">
    <component-audio version="1">
      <parameters num-parameters="7">
        <parameter id="LL" value="0.5"/>
        <parameter id="MV" value="0.9839"/>
        <parameter id="c" value="0.5"/>
        <parameter id="Cab" value="15"/>
        <parameter id="V" value="0"/>
        <parameter id="st" value="0.5"/>
        <parameter id="Pwr" value="1"/>
      </parameters>
    </component-audio>
  </component>
  <component id="33000">
    <component-audio version="1">
      <parameters num-parameters="8">
        <parameter id="Wet" value="0.1"/>
        <parameter id="Tm" value="0.15"/>
        <parameter id="Sz" value="0.25"/>
        <parameter id="H" value="0.4"/>
        <parameter id="L" value="0.35"/>
        <parameter id="Chr" value="0.5"/>
        <parameter id="iM" value="0"/>
        <parameter id="Pwr" value="1"/>
      </parameters>
    </component-audio>
  </component>
</non-fix-components>
</rack>
<realtimecontroldb>
<remotecontroldb>
<component-event-listeners>
  <connection-data><target controller-slot-id="0" component-id="172000" target-number="1" target-name="treble" min-value="0.5" max-value="0.85" controller-name="Treble"/></connection-data>
  <connection-data><target controller-slot-id="1" component-id="172000" target-number="1" target-name="bass" min-value="0.2" max-value="0.55" controller-name="Bass"/></connection-data>
  <connection-data><target controller-slot-id="2" component-id="48000" target-number="1" target-name="S" min-value="0.25" max-value="0.85" controller-name="Squeeze"/></connection-data>
  <connection-data><target controller-slot-id="3" component-id="33000" target-number="1" target-name="Wet" min-value="0" max-value="0.3" controller-name="Room"/></connection-data>
  <connection-data><target controller-slot-id="4" component-id="172000" target-number="1" target-name="volume" min-value="0.3" max-value="0.52" controller-name="Amp Volume"/></connection-data>
</component-event-listeners>
</remotecontroldb>
</realtimecontroldb>
</headroom-rig>
<headroom-library version="1" id="clean-highlife-bright" category="Clean" order="220" instrument="guitar" style="Afrobeat / Highlife">
  <description>Crisp, bright and sweet clean for interlocking highlife and soukous lines: light compression into a blackface combo with treble up and bass trimmed, driving four 10-inch speakers, in a small room. Play light, percussive two-finger patterns and short melodic ostinatos; every note rings clear.</description>
  <tags><tag>Clean</tag><tag>Afrobeat / Highlife</tag><tag>Bright</tag><tag>Compressed</tag><tag>Room</tag></tags>
  <sources>
    <source url="https://en.wikipedia.org/wiki/Highlife" title="Highlife (Wikipedia)"/>
    <source url="https://www.afropop.org/articles/ebo-taylor-part-1-highlife-and-afro-funk" title="Afropop Worldwide: Ebo Taylor, highlife and Afro-funk"/>
    <source url="https://musicinafrica.net/magazine/highlife-west-africa/" title="Music In Africa: highlife in West Africa"/>
    <source url="https://daily.redbullmusicacademy.com/2018/12/the-roots-of-soukous/" title="Red Bull Music Academy: Seben heaven, the roots of soukous"/>
  </sources>
</headroom-library>
</headroom-preset>
