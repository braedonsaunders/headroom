</headroom-rig>
<headroom-library version="1" id="clean-chicken-pickin" category="Clean" order="30" instrument="guitar" style="Country">
  <description>Snappy session-country clean: a squashy stomp compressor into a small blackface combo with treble up, a single slapback repeat around 110 ms and a touch of the amp's spring. Bridge pickup, hybrid picking, palm-muted notes against popped open strings. Squeeze sets the snap; Slap Time moves the echo.</description>
  <tags><tag>Clean</tag><tag>Country</tag><tag>Compressed</tag><tag>Slapback</tag><tag>Spring Reverb</tag></tags>
  <sources>
    <source url="https://faderandknob.com/blog/nashville-session-clean-tele-compressor" title="Fader &amp; Knob: Nashville session clean tone, Telecaster + compressor settings"/>
    <source url="https://tonestakr.com/guitarists/brent-mason/" title="Tonestakr: Brent Mason guitar tone and rig guide"/>
    <source url="https://gearspace.com/board/so-many-guitars-so-little-time/1279362-how-get-chicken-pickin-guitar-sounds-vst-compressor.html" title="Gearspace: chicken pickin sounds from a compressor"/>
    <source url="https://tonestakr.com/gear/amp/fender-deluxe-reverb/settings/" title="Tonestakr: Deluxe Reverb settings for blues and country"/>
  </sources>
</headroom-library>
</headroom-preset>
