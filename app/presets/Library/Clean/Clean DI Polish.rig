<headroom-library version="1" id="clean-di-polish" category="Clean" order="180" instrument="guitar" style="Studio">
  <description>No amp, no cabinet: the polished direct-to-console clean used on countless pop and funk records. A tube leveler smooths the dynamics, a console-style EQ trims boom and adds sheen, and a short room gives it a place in the mix. Glassy and immediate; great for funk, pop arpeggios and layering.</description>
  <tags><tag>Clean</tag><tag>Studio</tag><tag>Direct</tag><tag>Compressed</tag><tag>Amp-Free</tag></tags>
  <sources>
    <source url="https://www.guitarplayer.com/gear/i-only-play-one-guitar-nile-rodgers-riffs-on-his-famed-hitmaker" title="Guitar Player: Nile Rodgers on the Hitmaker (direct signal blended with the amp)"/>
    <source url="https://www.musicradar.com/news/cory-wong-the-key-to-it-all-the-starting-point-for-understanding-is-just-to-listen" title="MusicRadar: Cory Wong interview (position 4, always-on compressor, records DI)"/>
    <source url="https://www.soundonsound.com/sound-advice/guitar-re-amping" title="Sound On Sound: guitar re-amping (DI box between guitar and amp)"/>
    <source url="https://gearspace.com/board/so-much-gear-so-little-time/1226044-vocal-la2a-hack-engineer-gaaah.html" title="Gearspace: LA-2A on guitar vs vocal in pop tracking (2-4 dB on guitar)"/>
    <source url="https://en.wikipedia.org/wiki/LA-2A_Leveling_Amplifier" title="LA-2A Leveling Amplifier (Wikipedia)"/>
  </sources>
</headroom-library>
</headroom-preset>
