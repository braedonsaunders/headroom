</headroom-rig>
<headroom-library version="1" id="clean-studio-pop" category="Clean" order="20" instrument="guitar" style="Pop">
  <description>A polished modern pop clean that sits under a vocal: a tube leveling amp evens out every strum, a small blackface combo adds warmth and sparkle, and an EQ trims mud and adds air before a short plate. Strum or arpeggiate; the dynamics stay even and the top end stays smooth.</description>
  <tags><tag>Clean</tag><tag>Pop</tag><tag>Compressed</tag><tag>Plate Reverb</tag><tag>Studio</tag></tags>
  <sources>
    <source url="https://gearspace.com/board/so-much-gear-so-little-time/1226044-vocal-la2a-hack-engineer-gaaah.html" title="Gearspace: LA-2A on guitar vs vocal in pop tracking (2-4 dB on guitar)"/>
    <source url="https://www.musicradar.com/news/producers-guide-la-2a" title="MusicRadar: the producer's guide to the LA-2A"/>
    <source url="https://en.wikipedia.org/wiki/LA-2A_Leveling_Amplifier" title="LA-2A Leveling Amplifier (Wikipedia)"/>
    <source url="https://en.wikipedia.org/wiki/Fender_Deluxe_Reverb" title="Fender Deluxe Reverb (Wikipedia)"/>
  </sources>
</headroom-library>
</headroom-preset>
