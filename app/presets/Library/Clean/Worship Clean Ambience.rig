<headroom-tempo bpm="74.000"/>
<headroom-library version="1" id="clean-worship-ambience" category="Clean" order="160" instrument="guitar" style="Worship">
  <description>Modern worship clean: a compressor into a class-A top-boost combo just shy of breakup, a dotted-eighth delay locked to the rig tempo (74 BPM; set your own) and a big, modulated hall behind it. Swell chords with the volume knob or pick eighth notes and let the delay fill the gaps.</description>
  <tags><tag>Clean</tag><tag>Worship</tag><tag>Ambient</tag><tag>Delay</tag><tag>Dotted Eighth</tag><tag>Hall Reverb</tag></tags>
  <sources>
    <source url="https://reverb.com/news/the-gear-tones-and-techniques-of-modern-worship-guitar" title="Reverb: the gear, tones and techniques of modern worship guitar"/>
    <source url="https://worshiponline.com/worship-guitar-pedalboard/" title="Worship Online: how to build a worship guitar pedalboard"/>
    <source url="https://worshipguitarresources.com/the-complete-guide-to-worship-guitar-delay-settings/" title="Worship Guitar Resources: complete guide to worship delay settings"/>
    <source url="https://faderandknob.com/blog/vox-ac30-settings-guide" title="Fader &amp; Knob: AC30 settings from jangle to crunch"/>
  </sources>
</headroom-library>
</headroom-preset>
