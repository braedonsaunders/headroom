</headroom-rig>
<headroom-library version="1" id="clean-eighties-chorus" category="Clean" order="150" instrument="guitar" style="80s Pop">
  <description>The lush early-80s chorus clean: a stomp compressor into a solid-state 2x12 with its built-in stereo chorus on (dry on one side, chorused on the other) and a single digital echo around 330 ms. Bright, wide and hard-edged; arpeggiate add9 and sus chords and let them shimmer.</description>
  <tags><tag>Clean</tag><tag>80s Pop</tag><tag>New Wave</tag><tag>Chorus</tag><tag>Stereo</tag><tag>Delay</tag></tags>
  <sources>
    <source url="https://www.guitarplayer.com/guitarists/andy-summers-on-message-in-a-bottle-and-the-police-s-biggest-guitar-riff" title="Guitar Player: Andy Summers on Message in a Bottle"/>
    <source url="https://www.guitarworld.com/gear/tonal-recall-the-police-andy-summers" title="Guitar World: Tonal Recall, Andy Summers on Walking on the Moon"/>
    <source url="https://rolandcorp.com.au/blog/the-clean-legacy-of-the-roland-jazz-chorus" title="Roland Australia: the clean legacy of the Jazz Chorus"/>
    <source url="https://en.wikipedia.org/wiki/Roland_Jazz_Chorus" title="Roland Jazz Chorus (Wikipedia)"/>
  </sources>
</headroom-library>
</headroom-preset>
