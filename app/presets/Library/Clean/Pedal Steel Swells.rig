</headroom-rig>
<headroom-tempo bpm="72.000"/>
<headroom-library version="1" id="clean-steel-swells" category="Clean" order="40" instrument="guitar" style="Country">
  <description>A steel-guitar imitation: heavy compression for long sustain, a warm big blackface twin, a soft quarter-note echo and a long plate. Pick with the guitar volume off, then roll it up into the note; bend one string of a double-stop while the other holds. Sustain and Plate set how far each swell blooms.</description>
  <tags><tag>Clean</tag><tag>Country</tag><tag>Swells</tag><tag>Compressed</tag><tag>Plate Reverb</tag><tag>Delay</tag></tags>
  <sources>
    <source url="https://www.premierguitar.com/lessons/pedal-steel-effect" title="Premier Guitar: pedal-steel effect lesson"/>
    <source url="https://en.wikipedia.org/wiki/Volume_swell" title="Volume swell (Wikipedia)"/>
    <source url="https://www.tdpri.com/threads/volume-swells.374350/" title="TDPRI: volume swells (comp before volume, reverb after)"/>
    <source url="https://riff-mag.com/how-to-mimic-the-sound-of-pedal-steel-on-electric-guitar/" title="Riff Magazine: how to mimic pedal steel on electric guitar"/>
  </sources>
</headroom-library>
</headroom-preset>
