        <parameter id="BSp" value="0.5"/>
        <parameter id="CTn" value="1"/>
        <parameter id="Wt" value="1"/>
        <parameter id="Pwr" value="1"/>
      </parameters>
    </component-audio>
  </component>
  <component id="33000">
    <component-audio version="1">
      <parameters num-parameters="8">
        <parameter id="Wet" value="0.18"/>
        <parameter id="Tm" value="0.27375"/>
        <parameter id="Sz" value="0.45"/>
