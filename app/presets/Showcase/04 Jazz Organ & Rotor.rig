        <parameter id="level" value="0.8796"/>
        <parameter id="mix" value="1"/>
        <parameter id="Pwr" value="1"/>
        <parameter id="sound" value="9"/>
      </parameters>
    </component-audio>
  </component>
  <component id="31000">
    <component-audio version="1">
      <parameters num-parameters="15">
        <parameter id="SF" value="1"/>
        <parameter id="B" value="0.5"/>
        <parameter id="P" value="0.5"/>
        <parameter id="D" value="0.5"/>
        <parameter id="TS" value="0.5"/>
        <parameter id="TF" value="0.5"/>
        <parameter id="TA" value="0.5"/>
        <parameter id="TSp" value="0.5"/>
