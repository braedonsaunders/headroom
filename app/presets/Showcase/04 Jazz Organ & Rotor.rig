  <connection-data><target controller-slot-id="1" component-id="900003" target-number="1" target-name="tone" min-value="0.2" max-value="1" controller-name="Drawbars"/></connection-data>
  <connection-data><target controller-slot-id="2" component-id="33000" target-number="1" target-name="Wet" min-value="0" max-value="0.5" controller-name="Room"/></connection-data>
