<?xml version="1.0" encoding="UTF-8"?>
<headroom-preset version="1">
<headroom-info><soundinfo><properties><name>Jazz Organ &amp; Rotor</name><author>Headroom</author></properties></soundinfo></headroom-info>
<headroom-rig>
<metadata preset-name="Jazz Organ &amp; Rotor" preset-author="Headroom" preset-comment="Drawbar jazz organ through a rotating speaker cabinet. Hold chords and ride the Rotor Speed macro."/>
<rack>
