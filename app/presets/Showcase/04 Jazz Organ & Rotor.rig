        <parameter id="sens" value="0.55"/>
        <parameter id="bend" value="2"/>
        <parameter id="low" value="40"/>
        <parameter id="high" value="88"/>
        <parameter id="vel" value="0.5"/>
        <parameter id="thru" value="1"/>
        <parameter id="Pwr" value="1"/>
      </parameters>
    </component-audio>
  </component>
