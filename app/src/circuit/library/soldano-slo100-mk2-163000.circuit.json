{
 "schema": "headroom.circuit.v1",
 "id": "soldano-slo100-mk2-163000",
 "version": 1,
 "name": "Soldano SLO-100 MK II Super Lead Overdrive",
 "description": "Soldano SLO-100 MK II (Rev E), complete, from ONE source (a forum KiCad redraw; no second drawing was found to cross-check): V1A input, relay-switched Normal channel (K1 Clean/Crunch, Bright) and OD channel (OD pot, V2A, V2B cold clipper), K2/K3 channel relays, V3A + V3B cathode-follower tone stack, per-channel masters, K4-switched FX loop (V4B send follower, V4A recovery, Loop Level), long-tail-pair PI with presence and Depth in the 4-ohm-tap feedback, four 6L6GC, 100 W OT, 360-0-360 full-wave supply.",
 "sources": [
  {
   "title": "SUPER LEAD OVERDRIVE 100 / MK2 / REV: E / 11/2019 / (c) BOUTIQUE AMPS DISTRIBUTION / DRAWN BY RADIANTRELIC / FOR RESEARCH & REPAIR PURPOSES ONLY (KiCad vector PDF, 1 sheet)",
   "url": "https://el34world.com/Forum/index.php?action=dlattach;topic=31223.0;attach=124264",
   "note": "SINGLE SOURCE: a forum redraw, not a factory drawing, and no second source was found to cross-check it (slocloneforums.com and others not reachable/tried, see notes). Vector, fully legible; every value read at 1:1 from a 200/400 dpi render (crop coordinates in the notes)."
  }
 ],
 "oversampling": 4,
 "minRate": 176400,
 "lte": {
  "start": "bdf2",
  "tol": 8
 },
 "multirate": {
  "rates": {
   "V1A": 16
  },
  "events": true,
  "note": "Event-local oversampling (docs §10.48, §10.63): base 192 kHz, 4 substeps (768 kHz) on every LTE event of the signal group. 3130 Hz gate tone (own-mains mask) -63.6 / -58.7 / -61.2 -> -63.6 / -64.5 / -68.3 dB at 0.25 / 0.5 / 1.0 FS; 2900 Hz -70.4 / -68.0 / -61.9 -> -74.5 / -73.3 / -72.2. 8 substeps (V1A 32): -64.6 dB worst, +60 % CPU; BE start fails at 0.25 FS. Engine T/8 truth, audio band, lead / rock DI: 0.083 / 0.105 -> 0.046 / 0.080 %. 9900X real / driven: 53.0 / 56.2 -> 56.5 / 60.3 % of a core."
 },
 "io": {
  "input": "in",
  "output": "spk",
  "inputVoltsPerFS": 1.0,
  "outputVoltsPerFS": 317.0,
  "note": "outputVoltsPerFS = 1.5 x the 211 V peak at the speaker with the OD channel and every control dimed (1.0 V, 220 Hz; the peaks are the OT flyback as the 6L6s cut off, engine and ngspice agree on them). Dimed Normal channel: 74 V peak, 48 V rms."
 },
