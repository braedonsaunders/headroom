    { "ref": "EA", "type": "vcvs", "nodes": ["da", "0", "in", "0"], "gain": 30 },
    { "ref": "EB", "type": "vcvs", "nodes": ["db", "0", "in", "0"], "gain": -30 },
    { "ref": "CA", "type": "C", "nodes": ["da", "ga"], "value": "100n" },
