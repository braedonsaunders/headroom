{
  "schema": "headroom.circuit.v1",
  "id": "ibanez-ts808",
  "version": 1,
  "name": "Tube Screamer TS808",
  "description": "Ibanez TS808 overdrive: 2SC1815 emitter-follower input buffer, JRC4558 non-inverting clipping stage with a 1N914 pair in the feedback loop and the 4.7 kΩ / 47 nF (720 Hz) leg, 1 kΩ / 220 nF (723 Hz) passive low-pass into the JRC4558 active tone stage, Level pot and 2SC1815 output buffer with the TS808's 100 Ω / 10 kΩ output network. The electronic bypass switching (2SK30A JFETs) is omitted: in the effect-on state it is a closed switch in the signal path. Vref (R9/R10 10 kΩ divider + 47 µF) is an ideal 4.5 V node.",
  "sources": [
    {
      "title": "Pedal Parts Ltd, 'Tube Screamer v2.0' build document: TS808 schematic and BOM (R1 1k, R2 510k, R3 10k, R5 10k, R6 4k7, R7 51k, R8 1k, R11 220R, R12 510k, R13 10k, R14 10k, R15 100R, R16 10k, R17 1k, R18 1k, R22 1M; C1 22n, C2 1u, C3 47n, C5 220n, C8 1u, C9 220n, C10 100n, C11 10u; Drive 500kA, Tone 20kB, Level 100kA)",
      "url": "https://pedalparts.co.uk/docs/TubeScreamer2.pdf"
    },
    {
      "title": "R. G. Keen, 'The Technology of the Tube Screamer' (geofex.com): tone control topology (20k pot between the two inputs of the second op-amp, wiper RC to ground)",
      "url": "http://www.geofex.com/article_folders/tstech/tsxtech.htm"
    },
    {
      "title": "Barbarach BC, 'What is a Tube Screamer?': 720 Hz clipping-stage high-pass, 723 Hz tone-stage low-pass, 3.3 kHz tone corner",
      "url": "https://barbarach.com/what-is-a-tube-screamer/"
    },
    {
      "title": "Ibanez TS808 original values where the kit differs: C4 51 pF feedback cap, 1N914 clipping diodes, 2SC1815 buffers, JRC4558 op-amp (widely documented; e.g. Yeh, Abel & Smith, DAFx 2007)"
    }
  ],
  "io": {
    "input": "in",
    "output": "out",
    "inputVoltsPerFS": 1.0,
    "outputVoltsPerFS": 1.0
  },
  "oversampling": 2,
  "minRate": 176400,
  "solver": "auto",
  "multirate": {
    "oversampled": [
      "IC1A"
    ],
    "note": "Only the clipping partition (IC1A, its feedback network and the 1N914 pair) runs at 2x; the buffers and the tone stage run at the host rate with half-band converters at their exact one-way boundaries."
  },
  "controls": [
    {
      "id": "drive",
      "label": "Drive",
      "default": 0.5,
      "params": [
        "Dr"
      ],
      "group": "Main",
      "note": "500 kΩ audio-taper pot in series with R7 51 kΩ: gain 1 + (51k + Rdrive)/4.7k above 720 Hz"
    },
    {
      "id": "tone",
      "label": "Tone",
      "default": 0.5,
      "params": [
        "Tn"
      ],
      "group": "Main",
      "note": "20 kΩ linear pot between the + and − inputs of IC1B; wiper to 220 nF + 220 Ω"
    },
    {
      "id": "level",
      "label": "Level",
      "default": 0.5,
      "params": [
        "Vol"
      ],
      "group": "Main",
      "note": "100 kΩ audio-taper output pot"
    },
    {
      "id": "bass",
      "label": "Bass (C3 mod)",
      "default": 0.5,
      "params": [
        "Bs"
      ],
      "group": "Mods",
      "note": "The well-known 'more bass' mod: the 720 Hz leg capacitor C3, 22 nF … 100 nF (stock 47 nF at the centre). Lower corner = more bass into the clipper"
    },
    {
      "id": "bright",
      "label": "Bright (C9 mod)",
      "default": 0.5,
      "params": [
        "Br"
      ],
      "group": "Mods",
      "note": "Tone-range mod: the tone-control wiper capacitor C9, 470 nF … 100 nF (stock 220 nF at the centre). Smaller = brighter, wider tone range"
    },
    {
      "id": "clean",
      "label": "Clean",
      "default": 0.0,
      "params": [
        "Cl"
      ],
      "legacyOnly": true,
      "group": "Legacy",
      "note": "Catalogue control with no part in the TS808 circuit; stored for preset compatibility only"
    },
    {
      "id": "lamp",
      "label": "Lamp",
      "default": 1.0,
      "params": [
        "Lmp"
      ],
      "legacyOnly": true,
      "group": "Legacy",
      "note": "Indicator LED on the legacy unit: no effect on the audio circuit (the LED and its 4.7 kOhm resistor sit across the 9 V supply). Stored for presets only"
    },
    {"id": "stereo", "label": "Stereo", "kind": "continuous", "default": 0.5, "params": ["CASSt"], "legacyOnly": true, "group": "Legacy", "note": "Catalogue stereo parameter; the circuit is mono, stored only"},
    {"id": "power", "label": "On/Off", "kind": "switch", "default": 1.0, "params": ["Pwr"], "legacyOnly": true, "group": "Legacy", "note": "Host handles bypass; stored only"}
  ],
