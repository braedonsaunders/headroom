    },
    "2SD234": {
      "kind": "npn",
      "is": 1e-12,
      "bf": 70,
      "br": 4,
      "note": "unverified: NEC 2SD234 TO-220 power NPN (hFE 40-240); generic power-NPN Ebers-Moll values for +14 V series regulator pass transistor"
    },
    "2SB434": {
      "kind": "pnp",
      "is": 1e-12,
      "bf": 70,
      "br": 4,
      "note": "unverified: Toshiba 2SB434 TO-220 power PNP (hFE 40-240); generic power-PNP Ebers-Moll values for -14 V series regulator pass transistor"
    },
    "MN3002": {
      "kind": "bbd",
      "stages": 512,
      "eps": 0.05,
      "a2": 0.02,
      "vlo": -6.5,
      "vhi": -0.5,
      "vshift": 8.55,
      "rout": 100000,
      "noise": 0.00025,
      "note": "Panasonic MN3002 in CE-1's split-rail bias (VBB = +4.41 V, GND = 0 V, VBias = -3.45 V, VGG = -13.0 V, VDD = -14 V, external R24/R25 = 100 kOhm to 0 V): -6.5..-0.5 V input window centred on -3.45 V; rout = 100 kOhm + vshift = 8.55 V into R24/R25 = 100 kOhm reproduces -6.0 V DC at E and 0.50x (-6 dB) PMOS body-effect follower gain matching factory oscillograms D = 4 Vpp -> E = 2 Vpp"
    }
  },
