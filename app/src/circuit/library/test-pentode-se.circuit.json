  "parts": [
    { "ref": "BPLUS", "type": "V", "nodes": ["bp", "0"], "value": "300" },
    { "ref": "CIN", "type": "C", "nodes": ["in", "gi"], "value": "100n" },
    { "ref": "RG", "type": "R", "nodes": ["gi", "0"], "value": "220k" },
    { "ref": "RS", "type": "R", "nodes": ["gi", "g1"], "value": "1k" },
    { "ref": "V1", "type": "pentode", "nodes": ["p", "g2", "g1", "k"], "model": "6V6GT" },
    { "ref": "RK", "type": "R", "nodes": ["k", "0"], "value": "470" },
    { "ref": "CK", "type": "C", "nodes": ["k", "0"], "value": "22u" },
    { "ref": "RG2", "type": "R", "nodes": ["bp", "g2"], "value": "1k" },
    { "ref": "CG2", "type": "C", "nodes": ["g2", "0"], "value": "10u" },
    { "ref": "RL", "type": "R", "nodes": ["bp", "p"], "value": "5k" },
    { "ref": "CO", "type": "C", "nodes": ["p", "out"], "value": "100n" },
    { "ref": "RO", "type": "R", "nodes": ["out", "0"], "value": "100k" }
  ],
  "probes": ["p", "k", "g2"]
}
