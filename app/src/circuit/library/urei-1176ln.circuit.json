{
  "schema": "headroom.circuit.v1",
  "id": "urei-1176ln",
  "version": 1,
  "name": "UREI 1176LN Peak Limiter (Rev F)",
  "description": "United Recording Electronics Industries Model 1176LN Solid State Limiting Amplifier, Revision F (drawing R11914, S/N suffix F): constant-impedance 600 Ω bridged-T input attenuator (R1A/R1B, R2/R3 620 Ω) → UTC O-12 500:200 Ω input transformer (T1) → R6 27 kΩ / Q1 selected 2N5457 FET shunt gain cell with LN drain-source linearising feedback (C2, C5, R7/C3, R9/C4, R16 distortion null) → Q2–Q4 2N3391A Class-A signal preamp → R27 100 kΩ Output pot → Q5–Q9 Class-AB line amplifier (2N5087 Darlington driver, MPS-U05 / MPS-U55 output pair, C14 bootstrap) → B11148 1:1.732 output transformer (T2). Sidechain: Ratio section B signal divider (R22–R26, S1B–S4B) + S9 GR disable → Q12–Q15 2N3707 two-stage feedback control amplifier → CR3/CR4 FD333 full-wave rectifier biased from Ratio section A threshold chain (R87, R42–R45, S1A–S4A between Q-bias node and −10 V, producing the hardware All-Buttons bias shift) → R76/C22/R77 Attack and R78/R79 Release timing on C27 0.22 µF.",
  "sources": [
    {
      "title": "UREI Model 1176LN Solid State Limiting Amplifier Operating & Service Manual (schematic R119140 Rev F leaf 53, Rev G leaf 54, Rev K leaf 56; factory test & calibration §5)",
      "url": "https://archive.org/details/Urei_1176LN_owners_manual"
    },
    {
      "title": "Gyraf Audio redraw of UREI 1176LN Rev K schematic with marked DC operating voltages",
      "url": "https://www.gyraf.dk/gy_pd/1176/1176sch.gif"
    },
    {
      "title": "Siliconix Application Note AN105, 'FETs as Voltage-Controlled Resistors' (drain-to-gate 0.5·Vds linearisation)",
      "url": "https://www.vishay.com/docs/70598/70598.pdf"
    },
    {
      "title": "onsemi 2N5457 N-Channel JFET datasheet and InterFET 2N5457 SPICE parameters",
      "url": "https://www.onsemi.com/pdf/datasheet/2n5457-d.pdf"
    },
    {
      "title": "Sowter Type 1260 (UTC O-12 replacement) and Type 1486 (UREI B11148 50+50:150+150 replacement) transformer data",
      "url": "https://www.sowter.co.uk/vintage-audio-transformers.php"
    },
    {
      "title": "Headroom Wave C device research §5 (FET gain cell subthreshold smoothing ksub = 0.07 V)",
      "url": "work/circuit-netlists/wave-c/DEVICES.md"
    }
  ],
