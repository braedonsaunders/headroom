 "controls": [
  {
   "id": "threshold",
   "label": "Threshold",
   "kind": "continuous",
   "default": 0.5,
   "params": [
    "T0"
   ],
   "group": "Compressor",
   "note": "THRESHOLD pot (pins 39/40/24) into T3 through R22 360k: it moves the side-chain VCAs' gain, i.e. the level the rectifier sees. 0 = ACW (-15 dB mark), 1 = CW (+15 dB mark, most compression). Pot value assumed 10K LIN (notes 4.4)"
  },
  {
   "id": "makeup",
   "label": "Make Up",
   "kind": "continuous",
   "default": 0.0,
   "params": [
    "M1"
   ],
   "group": "Compressor",
   "note": "MAKE UP 25K LIN: the 12 V reference through R20 620k into T2B, i.e. a negative (gain) offset on the audio VCAs only. Measured 0 ... +13.3 dB"
  },
  {
   "id": "attack",
   "label": "Attack",
   "kind": "selector",
   "options": [
    "0.1 ms",
    "0.3 ms",
    "1 ms",
    "3 ms",
    "10 ms",
    "30 ms"
   ],
   "default": 0.4,
   "paramRange": [
    0,
    5
   ],
   "params": [
    "A2"
   ],
   "group": "Compressor",
   "note": "ATTACK SWITCH: R1 820R / R2 2k7 / R3 8k2 / R4 27k / R5 82k / R6 270k from bus D into the selected release capacitor. Raw 0..5 = the six positions"
  },
  {
   "id": "release",
   "label": "Release",
   "kind": "selector",
   "options": [
    "0.1 s",
    "0.3 s",
    "0.6 s",
    "1.2 s",
    "Auto"
   ],
   "default": 0.25,
   "paramRange": [
    0,
    4
   ],
   "params": [
    "R3"
   ],
   "group": "Compressor",
   "note": "RELEASE SWITCH: 0.47u with R12 180k / R11 270k / R10 560k / R9 1M2, or AUTO = (R7 91k || C1 0.47u) + (R8 750k || C2 6.8u). Raw 0..4 = the five positions (a raw 5 clamps to Auto)"
  },
  {
   "id": "ratio",
   "label": "Ratio",
   "kind": "selector",
   "options": [
    "2:1",
    "4:1",
    "10:1"
   ],
   "default": 0.5,
   "paramRange": [
    0,
    2
   ],
   "params": [
    "R4"
   ],
   "group": "Compressor",
   "note": "RATIO SWITCH (pins 36-39 on every 82E26): selects T7's feedback network. Raw 0/1/2 = 2:1 / 4:1 / 10:1 (higher raw values clamp to 10:1)"
  },
  {
   "id": "compin",
   "label": "Comp In",
   "kind": "switch",
   "default": 1,
   "params": [],
   "face": true,
   "group": "Compressor",
   "note": "the panel's compressor IN button: line A to +18 V. OUT opens the side chain (TR5 off, TR4 on), shorts the timing node (T15) and removes the make-up reference (D2/D3)"
  },
  {
   "id": "rv1l",
   "label": "Distortion null L (RV1)",
   "kind": "continuous",
   "default": 0.5,
   "params": [],
   "group": "Trims",
   "note": "RV1 50K on the left card, mid = 0 V"
  },
  {
   "id": "rv1r",
   "label": "Distortion null R (RV1)",
   "kind": "continuous",
   "default": 0.5,
   "params": [],
   "group": "Trims",
   "note": "RV1 50K on the right card, mid = 0 V"
  },
  {
   "id": "rv3",
   "label": "VCA law (RV3)",
   "kind": "continuous",
   "default": 0.053,
   "params": [],
   "group": "Trims",
   "note": "RV3 1K 'SET 5.2 VOLTS ON VCA' on 82E27; 0.053 = 53 ohm, RV3 + R72 = the E card's R51 100R (notes 4.3)"
  },
  {
   "id": "link",
   "label": "Link",
   "kind": "continuous",
   "default": 1.0,
   "params": [
    "L5"
   ],
   "legacyOnly": true,
   "group": "Legacy",
   "note": "the quad compressor is always linked: the four cards' rectifiers are diode-OR'd onto bus D (D6) and one 82E27 drives every VCA. Stored only"
  },
  {
   "id": "sidechain",
   "label": "Sidechain",
   "kind": "continuous",
   "default": 0.0,
   "params": [
    "E6"
   ],
   "legacyOnly": true,
   "group": "Legacy",
   "note": "the console's bus compressor has no side-chain filter or key input: the side chain is each bus's own signal through A2. Stored only"
  },
  {
   "id": "dry",
   "label": "Dry",
   "kind": "continuous",
   "default": 0.0,
   "params": [
    "D7"
   ],
   "legacyOnly": true,
   "group": "Legacy",
   "note": "no wet/dry mix on the cards. Stored only"
  },
  {
   "id": "output",
   "label": "Output",
   "kind": "continuous",
   "default": 0.5,
   "params": [
    "W8"
   ],
   "legacyOnly": true,
   "group": "Legacy",
   "note": "no output control on the cards (the bus level after the compressor is the master fader, i.e. console automation). Stored only"
  },
  {
   "id": "vum",
   "label": "VU Meter",
   "kind": "continuous",
   "default": 0.0,
   "params": [
    "VUM"
   ],
   "legacyOnly": true,
   "group": "Legacy",
   "note": "meter telemetry; the GR meter is the readout. Stored only"
  },
  {
   "id": "pwr",
   "label": "On/Off",
   "kind": "continuous",
   "default": 1.0,
   "params": [
    "Pwr"
   ],
   "legacyOnly": true,
   "group": "Legacy",
   "note": "host bypass. Stored only"
  }
