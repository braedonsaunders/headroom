 },
 "oversampling": 2,
 "solver": "dk",
 "multirate": {"rates": {"IC3B": 4, "IC3A": 4, "C027": 4}, "note": "The three clipping op-amp groups (IC3B pre-shaper, IC3A gain stage, the 1SS133 pair with C027) run at 192 kHz, the rest at 96 kHz (docs §10.62). At 96 kHz they fold at -36.6 dB (aliasing gate, every bin, 0.5 FS); any one or two of them raised leave -47.8 to -55.4 dB. Gate -65.0 / -73.0 / -63.1 dB at 0.25 / 0.5 / 1.0 FS. Engine 8x fine-step truth (band-limited), audio band, lead / rock DI: 0.546 / 0.574 -> 0.464 / 0.537 %; ngspice mt2_lead_d32 out 0.568 -> 0.476 %"},
 "cuts": [
  "vb"
 ],
