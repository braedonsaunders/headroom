{
 "schema": "headroom.circuit.v1",
 "id": "test-wide-ladder",
 "version": 1,
 "name": "Test: 68 coupled diode and BJT ports in one solve group",
 "description": "Regression for ENGINE_QUEUE item 17 (kMaxNlPorts 96): a resistor ladder with a diode to ground at every node (alternating polarity, 20 junctions) feeding 24 biased common-emitter 2N3904 stages through coupling caps, their collectors summed into one output node, so all 68 nonlinear ports couple in one solve group, above the old 48-port ceiling. Exercises the run-time-size Newton kernel, its Woodbury low-rank step and the fallback paths at that size.",
 "io": {
  "input": "in",
  "output": "out"
 },
 "oversampling": 2,
